# Emergency Response Backend — Environment Configuration
# Copy this file to .env and edit values as needed.

# API Server (backend) port
PORT=4000

# Frontend server port (separate from API)
FRONTEND_PORT=3000

# Admin session secret (change this in production)
SESSION_SECRET=emergency-response-secret-change-me

# CORS allowed origins (comma separated) — must include frontend URL
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
